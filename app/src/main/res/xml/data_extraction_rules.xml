<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: excluye base de datos y preferencias de copia en la nube y de
  transferencia entre dispositivos hasta definir una política explícita (docs/03_ARCHITECTURE.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
