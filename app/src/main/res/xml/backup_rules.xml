<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 e inferiores (API 28-30). allowBackup=false ya lo desactiva; se mantiene explícito. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
